{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dental Smart Management Base",
  "version": "0.1.0",
  "identifier": "com.dental.smart.management.base",
  "build": {
    "beforeDevCommand": "pnpm exec vite",
    "devUrl": "http://localhost:1424",
    "beforeBuildCommand": "pnpm exec tsc && pnpm exec vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Smart Management Base",
        "visible": false,
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk2NEM2NzM1NUU1RjhCNUQKUldSZGkxOWVOV2RNbG5jVDd5Lzg5a3ZmNk1ia0dvMUNLZzFKUGxnV2hiQnptdFgyeFVxYithcW4K",
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}